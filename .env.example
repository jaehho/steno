DEEPGRAM_API_KEY=

# Summaries and questions run through `claude -p` on its own login; no key.
# Optional. Model for both. Defaults to claude-opus-5.
# CLAUDE_MODEL=claude-sonnet-5

# Optional. Drop meeting audio after this many days, keeping the transcript,
# summary, notes and todos. 0 or unset keeps every recording forever.
# STENO_KEEP_AUDIO_DAYS=30

# Optional. 0 hides the tray icon, for a bar already running `steno bar`.
# STENO_TRAY=0
