# Project-local secrets, if any. No-op when .env is absent.
# Runtime config lives in ~/.config/steno/.env (steno init), not here.
dotenv_if_exists

# uv owns .venv. Do not use layout python: it would build a second
# venv under .direnv and ignore uv.lock.
# steno needs make venv (system python + --system-site-packages for gi).
if [[ -d .venv ]]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$VIRTUAL_ENV/bin"
else
  log_status "no .venv; run: make venv"
fi
