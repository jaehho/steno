# Maintainer: Jaeho Cho <jaeho2025@gmail.com>
#
# Local-build PKGBUILD. From the project root:
#   make install             # build + install (paru -Bi resolves the AUR deps)
#   sudo pacman -R steno
#
# Bump `pkgver` to match pyproject.toml on each release; bump `pkgrel` when you
# change the recipe without bumping the version.

pkgname=steno
pkgver=0.11.0
pkgrel=1
pkgdesc="Listens to your meetings and turns them into notes and todos"
arch=('any')
url="https://github.com/jaehho/steno"
license=('MIT')
# gtk4/libadwaita/python-gobject are the window; libpulse provides pactl and
# parec, which are how capture and meeting detection work at all; gstreamer is
# archive playback (GTK's own media backend is not packaged on Arch);
# libdbusmenu-glib is the tray icon's menu.
depends=(
  'python'
  'python-gobject'
  'glib2'
  'pango'
  'gtk4'
  'libadwaita>=1:1.6'
  'libdbusmenu-glib'
  'hicolor-icon-theme'
  'python-websockets'
  'python-httpx'
  'python-dotenv'
  'libpulse'
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-good'
)
optdepends=(
  'claude-code: `steno brief --new` drafts your brief with it'
  'libnotify: desktop notifications when a summary is ready'
  'python-numpy: `steno clean-echo`, for meetings recorded on speakers'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
# Local build: no remote source. We copy the project into $srcdir in prepare().
source=()
install=steno.install
sha256sums=()

prepare() {
  rm -rf "$srcdir/$pkgname"
  mkdir -p "$srcdir/$pkgname"
  cp -r "$startdir"/{src,tests,pyproject.toml,README.md,LICENSE,packaging} \
    "$srcdir/$pkgname/"
}

build() {
  cd "$srcdir/$pkgname"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/$pkgname"
  # Headless by construction: no audio device, no network, no display.
  PYTHONPATH=src python -m unittest discover -s tests -t .
}

package() {
  cd "$srcdir/$pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/dev.jaeho.Steno.desktop \
    "$pkgdir/usr/share/applications/dev.jaeho.Steno.desktop"
  install -Dm644 src/steno/data/icons/hicolor/scalable/apps/dev.jaeho.Steno.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.jaeho.Steno.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
