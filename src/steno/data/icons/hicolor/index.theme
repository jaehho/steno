[Icon Theme]
Name=Hicolor
Comment=Steno's own icons; a tray host searching only this folder needs this index
Directories=scalable/apps,scalable/status

[scalable/apps]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications

[scalable/status]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Status
